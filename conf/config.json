{
    "log": {
        "level": "debug",
        "development": false,
        "disableCaller": false,
        "disableStacktrace": false,
        "outputPaths": ["stderr"],
        "errorOutputPaths": ["stderr"]
    },
    "openai": {
        "model": "hy4-preview",
        "baseURLEnv": "TEST_OPENAI_BASE_URL",
        "apiKeyEnv": "TEST_OPENAI_API_KEY",
        "includeReasoning": false
    },
    "models": {
        "default": "default",
        "items": [
            {
                "name": "default",
                "provider": "openai",
                "model": "hy4-preview",
                "baseURLEnv": "TEST_OPENAI_BASE_URL",
                "apiKeyEnv": "TEST_OPENAI_API_KEY",
                "includeReasoning": false,
                "maxRetries": 3
            }
        ]
    },
    "engine": {
        "maxConcurrentTools": 10,
        "runTimeout": 900000000000
    },
    "token": {
        "contextWindow": 200000,
        "warnRatio": 0.8
    },
    "compactor": {
        "strategy": "summarization",
        "minTail": 6
    },
    "tool": {
        "enableApproval": true,
        "dangerCmds": ["ls -la", "rm -rf *", "ls"]
    },
    "memory": {
        "persistence": true
    },
    "ltm": {
        "enabled": false,
        "maxResults": 5
    },
    "sandbox": {
        "enabled": false,
        "image": "ubuntu:22.04",
        "networkDisabled": true,
        "readOnlyRootfs": false,
        "timeoutSecs": 120
    },
    "observability": {
        "enabled": false,
        "exporter": "stderr",
        "dumpIntervalSecs": 30
    },
    "skill": {
    }
}
