# code-agent-go 环境变量示例
# 用法：cp .env.example .env 后填入真实值。
# 加载顺序：./.env → ~/.code-agent-go/.env → ~/.env（第一个存在者生效）。
# 注意：这些变量名只是"变量名的名字"——实际读哪个环境变量由配置文件里的
#       openai.apiKeyEnv / openai.baseURLEnv（或 models.items[].*Env）指定。

# ---------------------------------------------------------------------------
# 运行期（Agent 真正用来调 LLM 的凭证）
# ---------------------------------------------------------------------------

# 大模型 API Key
OPENAI_API_KEY=your-api-key-here

# 网关 / Proxy 基础地址（如 https://api.openai.com/v1 或自建代理）
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# 仅用于集成测试（make test-live）
# ---------------------------------------------------------------------------

# 不配置时相关用例会自动跳过，不影响 make test / CI
TEST_OPENAI_API_KEY=your-api-key-here
TEST_OPENAI_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3
TEST_OPENAI_MODEL=hy3
