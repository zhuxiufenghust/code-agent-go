{
  "log": {
    "level": "info",
    "outputPaths": ["stderr"],
    "errorOutputPaths": ["stderr"]
  },
  "models": {
    "default": "smoke",
    "items": [
      {
        "name": "smoke",
        "provider": "openai",
        "model": "smoke-model",
        "baseURLEnv": "TEST_OPENAI_BASE_URL",
        "apiKeyEnv": "TEST_OPENAI_API_KEY"
      }
    ]
  },
  "engine": {
    "maxConcurrentTools": 5,
    "runTimeout": 120000000000
  },
  "token": {
    "contextWindow": 200000,
    "warnRatio": 0.8
  },
  "compactor": {
    "strategy": "summarization",
    "minTail": 6
  },
  "memory": {
    "persistence": false
  },
  "tool": {
    "enableApproval": true
  }
}
